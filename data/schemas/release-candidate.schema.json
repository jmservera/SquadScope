{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claracle.com/schemas/release-candidate.schema.json",
  "title": "Claracle Release Candidate Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "status",
    "candidate_sha",
    "candidate_product_tree_sha256",
    "candidate_frozen_at",
    "baseline",
    "findings",
    "sponsor",
    "rollback",
    "deployment",
    "outcomes"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "release_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["preparing", "blocked", "go", "deployed"] },
    "candidate_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_product_tree_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_frozen_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "required": ["phase4_merge_sha", "phase4_deployment_run", "verified_at"],
      "properties": {
        "phase4_merge_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "phase4_deployment_run": { "type": "integer", "minimum": 1 },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/finding" }
    },
    "sponsor": {
      "type": "object",
      "required": ["status", "reviewer", "decided_at", "candidate_sha"],
      "properties": {
        "status": { "enum": ["pending", "go", "no-go"] },
        "reviewer": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"], "format": "date-time" },
        "candidate_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["status", "owner", "last_known_good_sha", "steps", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "ready", "tested"] },
        "owner": { "type": "string", "minLength": 1 },
        "last_known_good_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["status", "merge_sha", "run_id", "deployed_at", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "completed", "failed"] },
        "merge_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": { "type": ["integer", "null"], "minimum": 1 },
        "deployed_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/outcome" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["type", "path", "sha256", "candidate_sha"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "workflow_run_id": { "type": ["integer", "null"], "minimum": 1 },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "review_finding": {
      "type": "object",
      "required": ["severity", "summary", "status"],
      "properties": {
        "severity": { "enum": [1, 2, 3, 4] },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] }
      },
      "additionalProperties": false
    },
    "owner_review": {
      "type": "object",
      "required": [
        "reviewer",
        "role",
        "reviewed_at",
        "candidate_sha",
        "disposition",
        "findings",
        "unresolved_work"
      ],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "disposition": { "enum": ["pass", "block"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_finding" }
        },
        "unresolved_work": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "live_at_review": {
      "type": ["object", "null"],
      "required": [
        "reviewer",
        "reviewed_at",
        "candidate_sha",
        "operating_system",
        "browser",
        "assistive_technology",
        "scenarios",
        "findings",
        "unresolved_work",
        "disposition"
      ],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "operating_system": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "assistive_technology": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_finding" }
        },
        "unresolved_work": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disposition": { "enum": ["pass", "fail"] }
      },
      "additionalProperties": false
    },
    "waiver": {
      "type": ["object", "null"],
      "required": [
        "approver",
        "rationale",
        "compensating_control",
        "issue_url",
        "candidate_sha",
        "decided_at",
        "expires_at"
      ],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "compensating_control": { "type": "string", "minLength": 1 },
        "issue_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"
        },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "decided_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "owner",
        "evidence",
        "reviews",
        "live_at_review",
        "waiver"
      ],
      "properties": {
        "id": { "pattern": "^DRF-0[1-5]$", "type": "string" },
        "severity": { "enum": [1, 2] },
        "status": { "enum": ["open", "closed", "deferred"] },
        "owner": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/owner_review" }
        },
        "live_at_review": { "$ref": "#/$defs/live_at_review" },
        "waiver": { "$ref": "#/$defs/waiver" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "window",
        "status",
        "owner",
        "due_at",
        "completed_at",
        "expected_sources",
        "acceptance_question",
        "baseline",
        "target",
        "evidence_destination",
        "evidence"
      ],
      "properties": {
        "window": {
          "enum": ["release-day", "seven-day", "28-day", "three-month", "six-month"]
        },
        "status": { "enum": ["pending", "scheduled", "completed"] },
        "owner": { "type": "string", "minLength": 1 },
        "due_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "expected_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance_question": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "evidence_destination": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
