{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claracle.com/schemas/cost-summary.schema.json",
  "title": "Claracle Public Cost Summary",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "currency",
    "pricing_basis",
    "provenance",
    "covered_period",
    "accepted_identities",
    "exclusions",
    "reconciliation",
    "totals"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "currency": { "const": "USD" },
    "pricing_basis": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" },
    "covered_period": { "type": "object" },
    "accepted_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workflow_run_id", "stage", "run_attempt", "week", "model"],
        "properties": {
          "workflow_run_id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "run_attempt": { "type": "integer", "minimum": 1 },
          "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
          "model": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "exclusions": { "type": "object" },
    "reconciliation": { "type": "object" },
    "totals": {
      "type": "object",
      "required": ["cost", "input_tokens", "output_tokens"],
      "properties": {
        "cost": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
