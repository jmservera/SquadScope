{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claracle.com/schemas/repository-record.schema.json",
  "title": "Claracle Repository Record",
  "type": "object",
  "required": [
    "id",
    "full_name",
    "name",
    "owner",
    "github_url",
    "language",
    "topics",
    "status",
    "first_seen_period",
    "last_seen_period",
    "recent_momentum",
    "context_summary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "full_name": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "github_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "language": { "type": ["string", "null"] },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": ["active", "archived", "disabled", "deleted", "renamed", "retained"]
    },
    "first_seen_period": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "last_seen_period": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "recent_momentum": { "type": ["number", "null"] },
    "context_summary": { "type": "string", "maxLength": 240 },
    "star_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period", "stars", "delta"],
        "properties": {
          "period": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
          "stars": { "type": "integer", "minimum": 0 },
          "delta": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
