{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claracle.com/schemas/ranking-record.schema.json",
  "title": "Claracle Ranking Record",
  "type": "object",
  "required": [
    "rank",
    "repository_id",
    "full_name",
    "github_url",
    "metric_key",
    "metric_value",
    "metric_label",
    "language",
    "context_summary",
    "context_accessible_text"
  ],
  "properties": {
    "rank": { "type": "integer", "minimum": 1 },
    "repository_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "full_name": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "github_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "metric_key": {
      "enum": ["stars", "star_velocity", "period_growth"]
    },
    "metric_value": { "type": "number" },
    "metric_label": { "type": "string", "minLength": 1 },
    "comparison_value": { "type": ["number", "null"] },
    "comparison_label": { "type": ["string", "null"] },
    "language": { "type": "string", "minLength": 1 },
    "context_summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "context_accessible_text": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "additionalProperties": false
}
