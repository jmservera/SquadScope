{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claracle.com/schemas/yearly-evidence-pack.schema.json",
  "title": "Claracle Yearly Evidence Pack",
  "type": "object",
  "required": ["schema_version", "artifact_type", "year", "months_covered", "sources", "claims", "counts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "yearly-evidence-pack" },
    "year": { "type": "integer", "minimum": 2000 },
    "months_covered": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "month", "week", "title", "top_repo", "tags"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-\\d{4}-W\\d{2}$" },
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
          "title": { "type": "string" },
          "top_repo": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "source_id", "claim_type", "text", "status"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^CLM-\\d{4}-W\\d{2}-[A-Z]+$" },
          "source_id": { "type": "string", "pattern": "^SRC-\\d{4}-W\\d{2}$" },
          "claim_type": { "enum": ["summary", "signal", "noise", "gaps", "conclusion"] },
          "text": { "type": "string", "minLength": 1 },
          "status": { "const": "resolved" }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["sources", "claims"],
      "properties": {
        "sources": { "type": "integer", "minimum": 1 },
        "claims": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
